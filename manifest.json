{
  "manifest_version": 3,
  "name": "Staple",
  "version": "0.1.0",
  "description": "Essential Chrome utilities packaged as a single fast, performant, and scalable extension",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "media/icon-16.png",
    "32": "media/icon-32.png",
    "48": "media/icon-48.png",
    "128": "media/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Staple",
    "default_popup": "action/action.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "permissions": ["storage"],
  "commands": {
    "tab-shift-left": {
      "description": "Move tabs left",
      "suggested_key": {
        "default": "Ctrl+Shift+PageUp",
        "mac": "MacCtrl+Shift+Left"
      }
    },
    "tab-shift-right": {
      "description": "Move tabs right",
      "suggested_key": {
        "default": "Ctrl+Shift+PageDown",
        "mac": "MacCtrl+Shift+Right"
      }
    },
    "tab-shift-to-next-window": {
      "description": "Move tabs to next window",
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "MacCtrl+Shift+Down"
      }
    },
    "tab-shift-undock": {
      "description": "Move tabs to new window",
      "suggested_key": {
        "mac": "MacCtrl+Shift+Up"
      }
    },
    "tab-switch": {
      "description": "Switch to previous tab"
    }
  }
}
