{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "avoid",
  "semi": false,
  "singleQuote": true,
  "sortImports": {
    "groups": [
      ["side_effect", "side_effect_style", "style"],
      "builtin",
      "external",
      ["index", "sibling", "parent"],
      "unknown"
    ],
    "newlinesBetween": true,
    "sortSideEffects": false
  },
  "sortPackageJson": false,
  "trailingComma": "es5"
}
